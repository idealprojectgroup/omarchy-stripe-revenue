{
  "schemaVersion": 1,
  "id": "io.github.idealprojectgroup.stripe-revenue",
  "name": "Stripe Revenue",
  "version": "0.1.0",
  "author": "Andrew Wicklander",
  "license": "MIT",
  "description": "Today's net Stripe income in the bar, with recent payments, upcoming payouts, and daily history in a click-open panel.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Stripe Revenue",
    "description": "Today's net income, live. Click for recent payments, upcoming payouts, and the last week — same day last month included.",
    "category": "Finance",
    "aliases": [
      "stripe",
      "revenue"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "pollSeconds": 60,
      "showCents": false,
      "days": 7
    },
    "schema": [
      {
        "key": "pollSeconds",
        "type": "number",
        "label": "Poll interval (seconds)",
        "defaultValue": 60
      },
      {
        "key": "showCents",
        "type": "boolean",
        "label": "Show cents in the bar",
        "defaultValue": false
      },
      {
        "key": "days",
        "type": "number",
        "label": "Days of history in the panel",
        "defaultValue": 7
      }
    ]
  }
}
