#!/usr/bin/env bash
# Net income from Stripe for the bar widget, printed as one line of JSON:
#   {"days":      [{"date":"YYYY-MM-DD","cents":N}, ...]   newest first,
#    "payments":  [{"at":EPOCH,"type":"charge","net":N,"desc":"..."}, ...]
#                 today's income rows, newest first, capped,
#    "last_month":{"date":"YYYY-MM-DD","cents":N}   same day one month back,
#    "updated":   EPOCH}
# Errors also come back as JSON ({"error":"no_key"|"auth"|"fetch_failed"})
# with exit 0, so the widget always has something to parse.
#
# Income is summed from /v1/balance_transactions .net (Stripe's fee already
# deducted) over income types only: direct charges, payments, and platform
# application fees, with refunds of each subtracting as their own negative
# entries. Everything else in the feed — payouts (type "transfer" on older
# API versions), Stripe Capital paydowns, Stripe's billing fees, top-ups —
# is money movement, not income, and is left out.
#
# Days are local-timezone calendar days. A finished day's total can no
# longer change (a balance transaction's created is immutable), so past
# days are cached and Stripe is only asked about today on most runs.
set -uo pipefail

KEY_FILE="${STRIPE_REVENUE_KEY_FILE:-$HOME/.config/stripe-revenue/api_key}"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/stripe-revenue"
# Pinned per-request so every account gets the same response shapes and
# speed. Ancient account-pinned versions auto-count list results, which
# makes their responses crawl or time out entirely.
STRIPE_VERSION="2024-06-20"
DAYS="${1:-7}"
[[ "$DAYS" =~ ^[0-9]+$ ]] && (( DAYS >= 1 && DAYS <= 31 )) || DAYS=7
PAYMENT_LIMIT=10

INCOME_FILTER='select(.type | IN("charge", "payment", "application_fee",
  "refund", "payment_refund", "application_fee_refund", "adjustment"))'

fail() {
  printf '{"error":"%s"}\n' "$1"
  exit 0
}

[[ -r "$KEY_FILE" ]] || fail no_key
KEY="$(head -n1 "$KEY_FILE" | tr -d '[:space:]')"
[[ -n "$KEY" ]] || fail no_key

now="$(date +%s)"

# fetch_rows GTE LT -> every income row in the window as one JSON array on
# stdout (pages merged); nonzero exit on any failure, 2 on auth. Lean rows
# only — totals need nothing but net, and a busy day is many pages.
fetch_rows() {
  local gte="$1" lt="$2" starting_after="" url page code body pages=""
  while :; do
    url="https://api.stripe.com/v1/balance_transactions?limit=100&created[gte]=${gte}&created[lt]=${lt}"
    [[ -n "$starting_after" ]] && url="${url}&starting_after=${starting_after}"
    page="$(curl -sg --max-time 45 -u "${KEY}:" -H "Stripe-Version: ${STRIPE_VERSION}" -w '\n%{http_code}' "$url")" || return 1
    code="${page##*$'\n'}"
    body="${page%$'\n'*}"
    [[ "$code" == "401" || "$code" == "403" ]] && return 2
    [[ "$code" == "200" ]] || return 1
    pages+="$(jq "[.data[] | ${INCOME_FILTER} | {created, type, net}]" <<<"$body")" || return 1
    pages+=$'\n'
    if [[ "$(jq -r '.has_more' <<<"$body")" == "true" ]]; then
      starting_after="$(jq -r '.data[-1].id' <<<"$body")"
    else
      break
    fi
  done
  jq -s 'add // []' <<<"$pages"
}

# day_total GTE LT CACHE_KEY -> total cents, from cache when a finished
# day was summed before. An empty CACHE_KEY (today) is never cached.
day_total() {
  local gte="$1" lt="$2" cache_key="$3" cache_file rows total
  if [[ -n "$cache_key" ]]; then
    cache_file="$CACHE_DIR/v2-$cache_key"
    if [[ -r "$cache_file" ]]; then
      cat "$cache_file"
      return 0
    fi
  fi
  rows="$(fetch_rows "$gte" "$lt")" || return $?
  total="$(jq 'map(.net) | add // 0' <<<"$rows")"
  if [[ -n "$cache_key" ]]; then
    mkdir -p "$CACHE_DIR"
    printf '%s\n' "$total" > "$CACHE_DIR/v2-$cache_key"
  fi
  echo "$total"
}

# Today's total: a lean scan of every row.
today_start="$(date -d "today 00:00" +%s)"
today_rows="$(fetch_rows "$today_start" "$now")" || { [[ $? -eq 2 ]] && fail auth; fail fetch_failed; }
today_total="$(jq 'map(.net) | add // 0' <<<"$today_rows")"

# The feed: one page of the newest rows (Stripe lists newest first), with
# the source expanded for payer identity — a direct charge's cardholder
# from its billing details (the description is just the plan name), or an
# application fee's connected account id, resolved to the studio's
# business name below. Expanding accounts inline is prohibitively slow,
# which is why they resolve one at a time into a permanent local cache.
# Best-effort: a failure here empties the feed for one poll, not the widget.
payments="[]"
resp="$(curl -sg --max-time 45 -u "${KEY}:" -H "Stripe-Version: ${STRIPE_VERSION}" -w '\n%{http_code}' \
  "https://api.stripe.com/v1/balance_transactions?limit=$(( PAYMENT_LIMIT * 3 ))&created[gte]=${today_start}&expand[]=data.source")" && {
  code="${resp##*$'\n'}"
  if [[ "$code" == "200" ]]; then
    payments="$(jq "[.data[] | ${INCOME_FILTER}
      | {at: .created, type, net, desc: (.description // \"\"),
         payer: (.source.billing_details.name? // \"\"),
         acct: (.source.account? // \"\")}] | .[0:${PAYMENT_LIMIT}]" <<<"${resp%$'\n'*}")" || payments="[]"
  fi
}

# Connected accounts resolve to business names once each, in parallel, and
# live in the cache from then on — a platform's studio roster barely
# changes. A name that fails to resolve just falls back to the row's
# description until a later poll gets it.
ACCOUNTS_CACHE="$CACHE_DIR/accounts.json"
accounts="$(cat "$ACCOUNTS_CACHE" 2>/dev/null)"
jq -e 'type == "object"' >/dev/null 2>&1 <<<"$accounts" || accounts="{}"

missing="$(jq -r --argjson known "$accounts" \
  '[.[] | .acct | select(. != "" and $known[.] == null)] | unique | .[0:12] | .[]' <<<"$payments")"
if [[ -n "$missing" ]]; then
  lookup_dir="$(mktemp -d)"
  for acct_id in $missing; do
    [[ "$acct_id" =~ ^acct_[A-Za-z0-9]+$ ]] || continue
    curl -sg --max-time 20 -u "${KEY}:" -H "Stripe-Version: ${STRIPE_VERSION}" \
      "https://api.stripe.com/v1/accounts/${acct_id}" \
      | jq -r '.business_profile.name? // .settings.dashboard.display_name? // empty' \
      > "$lookup_dir/$acct_id" 2>/dev/null &
  done
  wait
  for acct_id in $missing; do
    name="$(cat "$lookup_dir/$acct_id" 2>/dev/null)"
    [[ -n "$name" ]] || continue
    accounts="$(jq --arg id "$acct_id" --arg name "$name" '. + {($id): $name}' <<<"$accounts")"
  done
  rm -rf "$lookup_dir"
  mkdir -p "$CACHE_DIR"
  printf '%s\n' "$accounts" > "$ACCOUNTS_CACHE"
fi

payments="$(jq --argjson names "$accounts" \
  'map(if .payer == "" and .acct != "" then .payer = ($names[.acct] // "") else . end
       | del(.acct))' <<<"$payments")"

days="[{\"date\":\"$(date +%F)\",\"cents\":${today_total}}"
for (( i = 1; i < DAYS; i++ )); do
  day_date="$(date -d "$i days ago" +%F)"
  gte="$(date -d "$i days ago 00:00" +%s)"
  lt="$(date -d "$(( i - 1 )) days ago 00:00" +%s)"
  total="$(day_total "$gte" "$lt" "$day_date")" || { [[ $? -eq 2 ]] && fail auth; fail fetch_failed; }
  days+=",{\"date\":\"${day_date}\",\"cents\":${total}}"
done
days+="]"

# The same calendar day one month back, for the panel's comparison line.
# A past day, so it caches like the history above.
lm_date="$(date -d "1 month ago" +%F)"
lm_gte="$(date -d "$lm_date 00:00" +%s)"
lm_lt="$(date -d "$lm_date 00:00 + 1 day" +%s)"
lm_total="$(day_total "$lm_gte" "$lm_lt" "$lm_date")" || { [[ $? -eq 2 ]] && fail auth; fail fetch_failed; }
last_month="{\"date\":\"${lm_date}\",\"cents\":${lm_total}}"

# fetch_pending_rows GTE -> every still-pending balance transaction
# maturing on or after GTE as [{available_on, net}] on stdout; nonzero
# exit on any failure. Filtered server-side by available_on — pending
# funds all mature today or later, so this reads a few pages instead of
# scanning days of raw transactions.
fetch_pending_rows() {
  local gte="$1" starting_after="" url page code body pages=""
  while :; do
    url="https://api.stripe.com/v1/balance_transactions?limit=100&available_on[gte]=${gte}"
    [[ -n "$starting_after" ]] && url="${url}&starting_after=${starting_after}"
    page="$(curl -sg --max-time 45 -u "${KEY}:" -H "Stripe-Version: ${STRIPE_VERSION}" -w '\n%{http_code}' "$url")" || return 1
    code="${page##*$'\n'}"
    body="${page%$'\n'*}"
    [[ "$code" == "200" ]] || return 1
    pages+="$(jq '[.data[] | select(.status == "pending") | {available_on, net}]' <<<"$body")" || return 1
    pages+=$'\n'
    if [[ "$(jq -r '.has_more' <<<"$body")" == "true" ]]; then
      starting_after="$(jq -r '.data[-1].id' <<<"$body")"
    else
      break
    fi
  done
  jq -s 'add // []' <<<"$pages"
}

# What's on the way: upcoming payouts, and any payout already in transit
# with its arrival date. Upcoming payouts are the dashboard's breakdown,
# reproduced by grouping pending funds by the day they become available —
# weekend maturities roll forward to Monday, the day Stripe pays them.
# Best-effort — a restricted key without these permissions just leaves the
# fields empty rather than failing the widget.
#
# This is the expensive part (it pages through several days of raw
# transactions), and it moves slowly, so it recomputes at most every five
# minutes and is served from cache in between.
PAYOUT_CACHE="$CACHE_DIR/payout.json"
PAYOUT_TTL=300
payout_json=""
if [[ -r "$PAYOUT_CACHE" ]] && (( now - $(stat -c %Y "$PAYOUT_CACHE" 2>/dev/null || echo 0) < PAYOUT_TTL )); then
  payout_json="$(cat "$PAYOUT_CACHE")"
  jq -e . >/dev/null 2>&1 <<<"$payout_json" || payout_json=""
fi

if [[ -z "$payout_json" ]]; then
pending="null"
resp="$(curl -sg --max-time 20 -u "${KEY}:" -H "Stripe-Version: ${STRIPE_VERSION}" -w '\n%{http_code}' "https://api.stripe.com/v1/balance")" && {
  code="${resp##*$'\n'}"
  [[ "$code" == "200" ]] && pending="$(jq '[.pending[]?.amount] | add // 0' <<<"${resp%$'\n'*}")"
}
upcoming="[]"
if pending_rows="$(fetch_pending_rows "$(date -d 'yesterday 00:00' +%s)")"; then
  upcoming="$(jq '[ .[]
    | .available_on as $t
    | (($t | gmtime)[6]) as $wd
    | {date: (if $wd == 6 then $t + 2*86400 elif $wd == 0 then $t + 86400 else $t end), net} ]
    | group_by(.date)
    | map({date: (.[0].date | strftime("%Y-%m-%d")), cents: (map(.net) | add)})
    | sort_by(.date)' <<<"$pending_rows")"
fi
in_transit="null"
arrival="null"
resp="$(curl -sg --max-time 20 -u "${KEY}:" -H "Stripe-Version: ${STRIPE_VERSION}" -w '\n%{http_code}' "https://api.stripe.com/v1/payouts?limit=10")" && {
  code="${resp##*$'\n'}"
  if [[ "$code" == "200" ]]; then
    body="${resp%$'\n'*}"
    in_transit="$(jq '[.data[] | select(.status == "pending" or .status == "in_transit")
      | .amount] | add // 0' <<<"$body")"
    arrival="$(jq '[.data[] | select(.status == "pending" or .status == "in_transit")
      | .arrival_date] | min // null' <<<"$body")"
  fi
}

payout_json="$(jq -nc --argjson pending "$pending" --argjson in_transit "$in_transit" \
  --argjson arrival "$arrival" --argjson upcoming "$upcoming" \
  '{pending: $pending, in_transit: $in_transit, arrival: $arrival, upcoming: $upcoming}')"
mkdir -p "$CACHE_DIR"
printf '%s\n' "$payout_json" > "$PAYOUT_CACHE"
fi

jq -nc --argjson days "$days" --argjson payments "$payments" \
  --argjson last_month "$last_month" --argjson now "$now" \
  --argjson payout "$payout_json" \
  '{days: $days, payments: $payments, last_month: $last_month,
    payout: $payout, updated: $now}'
